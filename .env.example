# Names only. Copy to .env (root scripts) or web/.env.local (Next.js app) and fill in. Never commit real values.

# --- web/.env.local (Next.js app; NEXT_PUBLIC_* values are sent to the browser) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=
NUDGE_SECRET=
WHOOP_CLIENT_SECRET=
GITHUB_DISPATCH_TOKEN=
GITHUB_REPO=

# --- root .env (Python sync and import scripts) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=        # server-side jobs only: holds the service-role key; never expose to the browser
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=
WHOOP_REFRESH_TOKEN=

# --- Secrets for scheduled jobs: SUPABASE_URL, SUPABASE_ANON_KEY, VAPID_PUBLIC, VAPID_PRIVATE, VAPID_SUBJECT ---
